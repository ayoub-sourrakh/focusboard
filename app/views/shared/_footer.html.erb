<footer class="bg-gray-900 dark:bg-gray-950 text-gray-300 dark:text-gray-400 mt-20 transition-colors duration-200">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand Section -->
      <div class="col-span-1 md:col-span-1">
        <div class="flex items-center space-x-2 mb-4">
          <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-xl">F</span>
          </div>
          <span class="text-xl font-bold text-white">Focusboard</span>
        </div>
        <p class="text-sm text-gray-400 mb-4"><%= t('footer.tagline') %></p>
        <div class="flex space-x-4">
          <a href="#" class="text-gray-400 hover:text-blue-400 transition duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-blue-400 transition duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-blue-400 transition duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4"><%= t('footer.product') %></h3>
        <ul class="space-y-2">
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.features') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.pricing') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.roadmap') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.changelog') %></a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4"><%= t('footer.company') %></h3>
        <ul class="space-y-2">
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.about') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.blog') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.careers') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.contact') %></a></li>
        </ul>
      </div>

      <!-- Support Links -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4"><%= t('footer.support') %></h3>
        <ul class="space-y-2">
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.help_center') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.documentation') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.privacy_policy') %></a></li>
          <li><a href="#" class="text-sm hover:text-blue-400 transition duration-200"><%= t('footer.terms_of_service') %></a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 dark:border-gray-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-sm text-gray-400 dark:text-gray-500">
        &copy; <%= Time.current.year %> <%= t('app_name') %>. <%= t('footer.rights_reserved') %>
      </p>
      
      <!-- Language Selector Dropup -->
      <div class="relative my-4 md:my-0" data-controller="language-selector" data-action="click@window->language-selector#hide">
        <button type="button" 
                data-action="click->language-selector#toggle"
                class="flex items-center space-x-2 px-3 py-2 bg-gray-800 dark:bg-gray-900 hover:bg-gray-700 dark:hover:bg-gray-800 rounded-lg transition duration-200 text-gray-300 hover:text-white">
          <% case I18n.locale %>
          <% when :fr %>
            <span class="text-xl">🇫🇷</span>
            <span class="text-sm font-medium">FR</span>
          <% when :en %>
            <span class="text-xl">🇬🇧</span>
            <span class="text-sm font-medium">EN</span>
          <% when :es %>
            <span class="text-xl">🇪🇸</span>
            <span class="text-sm font-medium">ES</span>
          <% when :zh %>
            <span class="text-xl">🇨🇳</span>
            <span class="text-sm font-medium">ZH</span>
          <% end %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
          </svg>
        </button>
        
        <!-- Dropup Menu -->
        <div data-language-selector-target="menu" 
             class="hidden absolute bottom-full right-0 mb-2 w-32 bg-white dark:bg-gray-800 rounded-lg shadow-xl py-1 border border-gray-200 dark:border-gray-700">
          
          <!-- French -->
          <button type="button" 
                  data-action="click->language-selector#select"
                  data-locale="fr"
                  class="w-full text-left px-4 py-2 hover:bg-blue-50 dark:hover:bg-gray-700 transition duration-150 flex items-center space-x-3 <%= 'bg-blue-50 dark:bg-gray-700' if I18n.locale == :fr %>">
            <span class="text-xl">🇫🇷</span>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">FR</span>
            <% if I18n.locale == :fr %>
              <svg class="w-4 h-4 text-blue-600 ml-auto" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            <% end %>
          </button>
          
          <!-- English -->
          <button type="button" 
                  data-action="click->language-selector#select"
                  data-locale="en"
                  class="w-full text-left px-4 py-2 hover:bg-blue-50 dark:hover:bg-gray-700 transition duration-150 flex items-center space-x-3 <%= 'bg-blue-50 dark:bg-gray-700' if I18n.locale == :en %>">
            <span class="text-xl">🇬🇧</span>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">EN</span>
            <% if I18n.locale == :en %>
              <svg class="w-4 h-4 text-blue-600 ml-auto" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            <% end %>
          </button>
          
          <!-- Spanish -->
          <button type="button" 
                  data-action="click->language-selector#select"
                  data-locale="es"
                  class="w-full text-left px-4 py-2 hover:bg-blue-50 dark:hover:bg-gray-700 transition duration-150 flex items-center space-x-3 <%= 'bg-blue-50 dark:bg-gray-700' if I18n.locale == :es %>">
            <span class="text-xl">🇪🇸</span>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">ES</span>
            <% if I18n.locale == :es %>
              <svg class="w-4 h-4 text-blue-600 ml-auto" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            <% end %>
          </button>
          
          <!-- Chinese -->
          <button type="button" 
                  data-action="click->language-selector#select"
                  data-locale="zh"
                  class="w-full text-left px-4 py-2 hover:bg-blue-50 dark:hover:bg-gray-700 transition duration-150 flex items-center space-x-3 <%= 'bg-blue-50 dark:bg-gray-700' if I18n.locale == :zh %>">
            <span class="text-xl">🇨🇳</span>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">ZH</span>
            <% if I18n.locale == :zh %>
              <svg class="w-4 h-4 text-blue-600 ml-auto" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            <% end %>
          </button>
        </div>
      </div>
      
      <p class="text-sm text-gray-400">
        <%= t('footer.made_with_love') %> <span class="text-red-500">♥</span> <%= t('footer.by_team') %>
      </p>
    </div>
  </div>
</footer>
