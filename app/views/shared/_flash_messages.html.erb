<% if flash.any? %>
  <div data-controller="flash" class="fixed top-4 right-4 z-50 space-y-2 max-w-md">
    <% flash.each do |type, message| %>
      <% 
        case type.to_sym
        when :notice
          icon_color = "text-blue-500"
          bg_color = "bg-gradient-to-r from-blue-50 to-blue-100"
          border_color = "border-blue-200"
          icon_path = "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        when :alert, :error
          icon_color = "text-red-500"
          bg_color = "bg-gradient-to-r from-red-50 to-red-100"
          border_color = "border-red-200"
          icon_path = "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        when :success
          icon_color = "text-green-500"
          bg_color = "bg-gradient-to-r from-green-50 to-green-100"
          border_color = "border-green-200"
          icon_path = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        else
          icon_color = "text-gray-500"
          bg_color = "bg-gradient-to-r from-gray-50 to-gray-100"
          border_color = "border-gray-200"
          icon_path = "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        end
      %>
      
      <div data-flash-target="message" 
           data-action="click->flash#close"
           class="<%= bg_color %> <%= border_color %> border-l-4 rounded-lg shadow-xl p-4 flex items-start gap-3 animate-slide-in-right cursor-pointer hover:shadow-2xl transition-all duration-300">
        <!-- Icon -->
        <div class="flex-shrink-0">
          <svg class="w-6 h-6 <%= icon_color %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_path %>"></path>
          </svg>
        </div>
        
        <!-- Message -->
        <div class="flex-1 pt-0.5">
          <p class="text-sm font-medium text-gray-900"><%= message %></p>
        </div>
        
        <!-- Close Button -->
        <button type="button" 
                data-action="click->flash#close:stop"
                class="flex-shrink-0 text-gray-400 hover:text-gray-600 transition-colors duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
