<div class="min-h-[calc(100vh-16rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl w-full">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="mx-auto w-16 h-16 bg-gradient-to-br from-green-500 to-blue-600 rounded-2xl flex items-center justify-center mb-4 shadow-lg">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2"><%= t('auth.sign_up.title') %></h2>
      <p class="text-gray-600 dark:text-gray-300"><%= t('auth.sign_up.subtitle') %></p>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-6 md:p-8 border border-gray-100 dark:border-gray-700 transition-colors duration-200">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Personal Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, "#{t('auth.sign_up.first_name')} *", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <%= f.text_field :first_name, autofocus: true, placeholder: "John", class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
            </div>
          </div>

          <div>
            <%= f.label :last_name, "#{t('auth.sign_up.last_name')} *", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <%= f.text_field :last_name, placeholder: "Doe", class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
            </div>
          </div>
        </div>

        <div>
          <%= f.label :email, "#{t('auth.sign_in.email')} *", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
              </svg>
            </div>
            <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>
        </div>

        <div>
          <%= f.label :birth_date, "#{t('auth.sign_up.birth_date')} *", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <%= f.date_field :birth_date, class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>
        </div>

        <div>
          <%= f.label :street_address, "#{t('auth.sign_up.street_address')} (#{t('common.optional')})", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
          <div class="relative">
            <div class="absolute top-3 left-0 pl-3 pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <%= f.text_field :street_address, placeholder: t('auth.sign_up.street_address_placeholder'), class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :city, "#{t('auth.sign_up.city')} (#{t('common.optional')})", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
            <%= f.text_field :city, placeholder: t('auth.sign_up.city_placeholder'), class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>
          <div>
            <%= f.label :postal_code, "#{t('auth.sign_up.postal_code')} (#{t('common.optional')})", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
            <%= f.text_field :postal_code, placeholder: t('auth.sign_up.postal_code_placeholder'), class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
          </div>
        </div>

        <div>
          <%= f.label :country, "#{t('auth.sign_up.country')} (#{t('common.optional')})", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
          <%= f.text_field :country, placeholder: t('auth.sign_up.country_placeholder'), class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :password, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
              <%= t('auth.sign_up.password') %> *
              <% if @minimum_password_length %>
                <span class="text-xs font-normal text-gray-500 dark:text-gray-400">(<%= @minimum_password_length %> <%= t('auth.sign_up.chars_min') %>)</span>
              <% end %>
            <% end %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
              </div>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
            </div>
          </div>

          <div>
            <%= f.label :password_confirmation, "#{t('auth.sign_up.password_confirmation')} *", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200" %>
            </div>
          </div>
        </div>

        <div>
          <%= f.submit t('auth.sign_up.submit'), class: "w-full bg-gradient-to-r from-green-500 to-blue-600 hover:from-green-600 hover:to-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>

    <!-- Terms Note -->
    <p class="mt-6 text-center text-xs text-gray-500">
      <%= t('auth.sign_up.terms_note') %>
    </p>
  </div>
</div>
