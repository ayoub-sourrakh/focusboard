<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class="bg-gradient-to-r from-red-50 to-pink-50 border-l-4 border-red-500 rounded-xl p-6 mb-6 shadow-lg animate-shake">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
      <div class="ml-3 flex-1">
        <h3 class="text-red-800 font-bold text-lg mb-2">
          <%= resource.errors.count %> <%= resource.errors.count == 1 ? t('errors.prevented_saving') : t('errors.prevented_saving_plural') %>
        </h3>
        <ul class="space-y-2">
          <% resource.errors.full_messages.each do |message| %>
            <li class="flex items-start text-red-700">
              <svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
              <span class="font-medium"><%= message %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
