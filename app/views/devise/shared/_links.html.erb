<div class="mt-6 text-center space-y-3">
  <%- if controller_name != 'sessions' %>
    <%= link_to t('links.sign_in'), new_session_path(resource_name), class: "text-blue-600 hover:text-blue-800 text-sm" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <div>
      <%= link_to t('links.sign_up'), new_registration_path(resource_name), class: "text-blue-600 hover:text-blue-800 text-sm" %>
    </div>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <div>
      <%= link_to t('links.forgot_password'), new_password_path(resource_name), class: "text-blue-600 hover:text-blue-800 text-sm" %>
    </div>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <div>
      <%= link_to t('links.didnt_receive_confirmation'), new_confirmation_path(resource_name), class: "text-blue-600 hover:text-blue-800 text-sm" %>
    </div>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <div>
      <%= link_to t('links.didnt_receive_unlock'), new_unlock_path(resource_name), class: "text-blue-600 hover:text-blue-800 text-sm" %>
    </div>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <div>
        <%= button_to t('links.sign_in_with', provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "text-blue-600 hover:text-blue-800 text-sm" %>
      </div>
    <% end %>
  <% end %>
</div>
