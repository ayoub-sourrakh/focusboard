<div class="max-w-4xl mx-auto py-8">
  <!-- Profile Header -->
  <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl shadow-xl p-8 mb-8 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-10 rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white opacity-10 rounded-full -ml-24 -mb-24"></div>
    
    <div class="relative flex flex-col md:flex-row items-center md:items-start gap-6">
      <!-- Profile Photo -->
      <div class="flex-shrink-0">
        <% if @user.photo.attached? %>
          <%= image_tag @user.photo, class: "w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg" %>
        <% else %>
          <div class="w-32 h-32 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 bg-opacity-20 backdrop-blur-sm flex items-center justify-center text-white text-5xl font-bold border-4 border-white shadow-lg">
            <%= @user.initials %>
          </div>
        <% end %>
      </div>
      
      <!-- User Info -->
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-4xl font-bold mb-2"><%= @user.full_name %></h1>
        <p class="text-blue-100 text-lg mb-4">@<%= @user.username %></p>
        <p class="text-blue-100 text-lg mb-4"><%= @user.email %></p>
        <div class="flex flex-wrap gap-2 justify-center md:justify-start">
          <%= link_to edit_user_registration_path, class: "inline-flex items-center px-4 py-2 bg-white text-blue-600 rounded-lg font-medium hover:bg-blue-50 transition duration-200 shadow-md transform hover:-translate-y-0.5" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <%= t('profile.edit_profile') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Profile Information Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- Personal Information -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 border border-gray-100 dark:border-gray-700 transition-colors duration-200">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
        <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <%= t('profile.personal_info') %>
      </h2>
      <div class="space-y-4">
        <div>
          <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.full_name') %></label>
          <p class="text-gray-900 dark:text-white font-medium"><%= @user.full_name %></p>
        </div>
        <div>
          <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.email_address') %></label>
          <p class="text-gray-900 dark:text-white font-medium"><%= @user.email %></p>
        </div>
        <div>
          <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.date_of_birth') %></label>
          <p class="text-gray-900 dark:text-white font-medium">
            <%= @user.birth_date ? l(@user.birth_date, format: :long) : t('profile.not_provided') %>
          </p>
        </div>
      </div>
    </div>

    <!-- Contact Information -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 border border-gray-100 dark:border-gray-700 transition-colors duration-200">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
        <svg class="w-6 h-6 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <%= t('profile.contact_location') %>
      </h2>
      <div class="space-y-4">
        <% if @user.street_address.present? || @user.city.present? || @user.postal_code.present? || @user.country.present? %>
          <div>
            <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.address') %></label>
            <div class="text-gray-900 dark:text-white font-medium">
              <% if @user.street_address.present? %>
                <p><%= @user.street_address %></p>
              <% end %>
              <% if @user.city.present? || @user.postal_code.present? %>
                <p><%= [@user.postal_code, @user.city].compact.join(' ') %></p>
              <% end %>
              <% if @user.country.present? %>
                <p><%= @user.country %></p>
              <% end %>
            </div>
          </div>
        <% else %>
          <div>
            <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.address') %></label>
            <p class="text-gray-400 dark:text-gray-500 italic"><%= t('profile.no_address') %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Account Statistics -->
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 border border-gray-100 dark:border-gray-700 mb-8 transition-colors duration-200">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
      <svg class="w-6 h-6 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <%= t('profile.account_activity') %>
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="text-center p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
        <p class="text-3xl font-bold text-blue-600">0</p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('profile.total_tasks') %></p>
      </div>
      <div class="text-center p-4 bg-green-50 dark:bg-green-900/20 rounded-lg">
        <p class="text-3xl font-bold text-green-600">0</p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('profile.completed') %></p>
      </div>
      <div class="text-center p-4 bg-purple-50 dark:bg-purple-900/20 rounded-lg">
        <p class="text-3xl font-bold text-purple-600">0</p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('profile.in_progress') %></p>
      </div>
      <div class="text-center p-4 bg-amber-50 dark:bg-amber-900/20 rounded-lg">
        <p class="text-3xl font-bold text-amber-600"><%= (Date.today - @user.created_at.to_date).to_i %></p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('profile.days_active') %></p>
      </div>
    </div>
  </div>

  <!-- Account Details -->
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 border border-gray-100 dark:border-gray-700 transition-colors duration-200">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
      <svg class="w-6 h-6 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <%= t('profile.account_details') %>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.member_since') %></label>
        <p class="text-gray-900 dark:text-white font-medium"><%= l(@user.created_at, format: :long) %></p>
      </div>
      <div>
        <label class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('profile.last_updated') %></label>
        <p class="text-gray-900 dark:text-white font-medium"><%= l(@user.updated_at, format: :short) %></p>
      </div>
    </div>
  </div>
</div>
