<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="max-w-4xl mx-auto py-8">
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 transition-colors duration-200">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2"><%= t('settings.title') %></h1>
      <p class="text-gray-600 dark:text-gray-300"><%= t('settings.subtitle') %></p>
    </div>

    <!-- Dark Mode Toggle Section -->
    <div class="border-b border-gray-200 dark:border-gray-700 pb-8 mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
        <svg class="w-6 h-6 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <%= t('settings.dark_mode.title') %>
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-6"><%= t('settings.dark_mode.description') %></p>
      
      <%= button_to toggle_dark_mode_path, method: :post, data: { turbo: false }, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-600 hover:to-indigo-700 text-white font-semibold rounded-lg transition duration-200 shadow-md hover:shadow-lg transform hover:-translate-y-0.5" do %>
        <% if current_user.dark_mode? %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <%= t('settings.dark_mode.disable') %>
        <% else %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
          <%= t('settings.dark_mode.enable') %>
        <% end %>
      <% end %>
    </div>

    <!-- Change Password Section -->
    <div class="border-b border-gray-200 dark:border-gray-700 pb-8 mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
        <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <%= t('settings.change_password.title') %>
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-6"><%= t('settings.change_password.description') %></p>

      <%= form_for(@user, as: :user, url: registration_path(:user), html: { method: :put, class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :current_password, t('settings.change_password.current_password'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200", placeholder: t('settings.change_password.current_password_placeholder') %>
        </div>

        <div>
          <%= f.label :password, t('settings.change_password.new_password'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200", placeholder: t('settings.change_password.new_password_placeholder') %>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('settings.change_password.password_hint', count: 6) %></p>
        </div>

        <div>
          <%= f.label :password_confirmation, t('settings.change_password.confirm_password'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200", placeholder: t('settings.change_password.confirm_password_placeholder') %>
        </div>

        <div class="flex justify-end">
          <%= f.submit t('settings.change_password.submit'), class: "px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-semibold rounded-lg transition duration-200 shadow-md hover:shadow-lg transform hover:-translate-y-0.5" %>
        </div>
      <% end %>
    </div>

    <!-- Danger Zone -->
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-6">
      <h2 class="text-xl font-semibold text-red-900 dark:text-red-400 mb-2 flex items-center">
        <svg class="w-6 h-6 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <%= t('settings.danger_zone.title') %>
      </h2>
      <p class="text-sm text-red-700 dark:text-red-300 mb-4"><%= t('settings.danger_zone.description') %></p>
      
      <%= button_to registration_path(:user), 
          method: :delete, 
          data: { 
            turbo_method: :delete,
            turbo_confirm: t('settings.danger_zone.confirm_message')
          },
          class: "px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition duration-200 shadow-md hover:shadow-lg inline-flex items-center transform hover:-translate-y-0.5" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        <span><%= t('settings.danger_zone.delete_account') %></span>
      <% end %>
    </div>

  </div>
  <!-- Back to Profile -->
  <div class="mt-8 text-center">
    <%= link_to user_profile_path(current_user.username), class: "text-blue-600 hover:text-blue-800 font-medium inline-flex items-center" do %>
      <%= t('settings.back_to_profile') %>
    <% end %>
  </div>
</div>
